{
  "name": "helmo-workspace",
  "private": true,
  "version": "0.6.1",
  "description": "Helmo workspace: work record, roadmap, runtime, and their shared core.",
  "workspaces": [
    "packages/core",
    "packages/work",
    "packages/roadmap",
    "packages/runtime"
  ],
  "scripts": {
    "prepare:cold": "node scripts/prepare-build.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/build.test.mjs && npm run test --workspaces --if-present"
  },
  "publish": {
    "cold": {
      "scripts": ["prepare:cold", "build", "test"]
    }
  }
}
