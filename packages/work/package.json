{
  "name": "helmo",
  "version": "0.6.0",
  "description": "Agent work record: agents write, humans read and meet.",
  "scripts": {
    "test": "vitest run --exclude 'test/view-viewport-render.test.ts' --exclude 'test/view-release-floor.test.ts' && vitest run test/view-release-floor.test.ts",
    "build": "tsc",
    "postbuild": "node scripts/stamp-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "floor": "vitest run test/view-release-floor.test.ts",
    "viewport": "vitest run test/view-viewport-render.test.ts",
    "browser": "playwright-core install chromium --only-shell --no-remove",
    "screenshot": "node scripts/screenshot.mjs",
    "live-floor": "node --import tsx scripts/live-floor.mjs",
    "view": "tsx src/view.ts",
    "mcp": "tsx src/server.ts",
    "demo": "node --import tsx scripts/demo-seed.mjs",
    "vendor:tokens": "node scripts/vendor-estate-tokens.mjs",
    "vendor:avatars": "node scripts/vendor-estate-avatars.mjs"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "issue-tracker",
    "work-record",
    "agent-orchestration",
    "sqlite"
  ],
  "author": "Arthur Coulston",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurcoulston/helmo.git"
  },
  "homepage": "https://github.com/arthurcoulston/helmo#readme",
  "bugs": {
    "url": "https://github.com/arthurcoulston/helmo/issues"
  },
  "type": "module",
  "dependencies": {
    "@helmo/core": "0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "helmo-mcp": "dist/server.js",
    "helmo-view": "dist/view.js",
    "helmo-cli": "dist/cli.js"
  }
}
